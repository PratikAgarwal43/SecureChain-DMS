# =========================================
# SECURECHAIN DMS - ENVIRONMENT VARIABLES
# =========================================

# --- VAULT 1: PostgreSQL ---
# Update this with your actual postgres password if different
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD_HERE@localhost:5432/securechain_db

# --- VAULT 2: Cloudflare R2 (S3 Compatible) ---
# Replace these with your Cloudflare R2 bucket details
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=securechain-vault2
